DATABASE_URL=postgresql://postgres:postgres@localhost:5432/costcheqmate
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-long-random-secret
JWT_SECRET=replace-with-long-random-secret

# Optional OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OCR + notification provider
ABACUSAI_API_KEY=
WEB_APP_ID=
NOTIF_ID_NEW_USER_SIGNUP=
NOTIF_ID_BUG_REPORT_SUBMISSION=
NOTIF_ID_ROLE_UPGRADE_NOTIFICATION=

# Stripe (fallback if not stored in moderator settings)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AWS/S3 uploads
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloud storage OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Apple IAP server verification
APPLE_IAP_BUNDLE_ID=com.costcheqmate.mobile
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_SHARED_SECRET=
APPLE_IAP_PREMIUM_PRODUCTS=com.costcheqmate.premium.monthly
APPLE_IAP_BUSINESS_PRODUCTS=com.costcheqmate.business.monthly
