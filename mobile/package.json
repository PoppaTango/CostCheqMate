{
  "name": "costcheqmate-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "release:doctor": "npx expo-doctor",
    "release:preview": "eas build --profile preview",
    "release:preview:ios": "eas build --platform ios --profile preview",
    "release:preview:android": "eas build --platform android --profile preview",
    "release:prod": "eas build --profile production",
    "release:prod:ios": "eas build --platform ios --profile production",
    "release:prod:android": "eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.3",
    "expo": "^54.0.13",
    "expo-constants": "~18.0.13",
    "expo-image-picker": "^17.0.7",
    "expo-linking": "^8.0.8",
    "expo-local-authentication": "^17.0.7",
    "expo-router": "^6.0.13",
    "expo-secure-store": "^15.0.7",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "^5.9.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react"
        ]
      }
    }
  }
}
